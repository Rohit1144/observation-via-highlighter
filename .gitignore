# Secrets / local config: never commit credentials
.env
.env.*
agentcore/.env.local
*.pem

# Local state with account-specific ARNs (e.g. .harness.local.json from create_harness)
*.local.json

# IAM policies with the real account id filled in (templates in infra/iam/ are committed)
infra/iam/rendered/

# Agent run evidence (question, tool calls, code, answers, raw event stream)
runs/

# Runtime state written by the mock API (flags from write-back actions)
data/runtime/

# Python
.pytest_cache/
__pycache__/
.venv/

# Node
.npm-global/
node_modules/

# Nix
result
result-*
.direnv/
